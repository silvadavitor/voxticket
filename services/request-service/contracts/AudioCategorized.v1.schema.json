{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AudioCategorized.v1.schema.json",
  "title": "AudioCategorized v1",
  "description": "Texto classificado (v1: categoria; v2: + prioridade/confiança — bônus de versionamento). Produtor: categorization-service. Consumidores: request-service.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "AudioCategorized"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "requestId",
        "category"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    }
  }
}
