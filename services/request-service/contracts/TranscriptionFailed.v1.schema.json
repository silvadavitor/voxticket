{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TranscriptionFailed.v1.schema.json",
  "title": "TranscriptionFailed v1",
  "description": "Transcrição falhou após N tentativas. Produtor: transcription-worker. Consumidores: request-service.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "TranscriptionFailed"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "requestId",
        "reason"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
