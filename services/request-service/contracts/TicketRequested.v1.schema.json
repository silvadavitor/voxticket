{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TicketRequested.v1.schema.json",
  "title": "TicketRequested v1",
  "description": "Pede a abertura do chamado. Produtor: request-service. Consumidores: ticket-service.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "TicketRequested"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "requestId",
        "tenantId",
        "category"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "transcriptKey": {
          "type": "string",
          "minLength": 1,
          "description": "Chave do objeto no S3 (claim-check)"
        }
      },
      "additionalProperties": true
    }
  }
}
