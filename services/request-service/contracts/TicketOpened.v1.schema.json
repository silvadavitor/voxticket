{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TicketOpened.v1.schema.json",
  "title": "TicketOpened v1",
  "description": "Chamado aberto. Evento com vários interessados. Produtor: ticket-service. Consumidores: request-service, quota-service, notification-service.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "TicketOpened"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "requestId",
        "tenantId",
        "ticketId"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "ticketId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
