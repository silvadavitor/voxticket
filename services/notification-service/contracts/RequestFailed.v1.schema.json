{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RequestFailed.v1.schema.json",
  "title": "RequestFailed v1",
  "description": "Pedido terminou sem chamado; cliente deve ser avisado. Produtor: request-service. Consumidores: notification-service.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "RequestFailed"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "requestId",
        "tenantId",
        "finalStatus"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "finalStatus": {
          "type": "string",
          "enum": [
            "REJECTED",
            "FAILED",
            "EXPIRED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
