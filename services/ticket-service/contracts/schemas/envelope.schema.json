{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.schema.json",
  "title": "Envelope",
  "description": "Envelope comum a TODAS as mensagens. correlationId = requestId.",
  "type": "object",
  "required": [
    "messageId",
    "correlationId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "AudioCategorized",
        "AudioReceived",
        "AudioTranscribed",
        "CategorizationRequested",
        "CreditRejected",
        "CreditReleaseRequested",
        "CreditReserved",
        "RequestFailed",
        "TicketOpened",
        "TicketRejected",
        "TicketRequested",
        "TranscriptDiscardRequested",
        "TranscriptionFailed",
        "TranscriptionRequested"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
