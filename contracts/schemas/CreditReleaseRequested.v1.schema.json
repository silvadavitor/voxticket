{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CreditReleaseRequested.v1.schema.json",
  "title": "CreditReleaseRequested v1",
  "description": "Compensação: devolver o crédito reservado (só se RESERVED). Produtor: request-service. Consumidores: quota-service.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "CreditReleaseRequested"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "requestId",
        "tenantId"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
