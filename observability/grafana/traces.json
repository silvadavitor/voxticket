{
  "uid": "voxticket-traces",
  "title": "VoxTicket — Traces",
  "description": "Mapa dos serviços, pedidos recentes, mais lentos e com erro. Clique num trace para ver a cascata do pedido inteiro.",
  "tags": [
    "voxticket"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "nodeGraph",
      "title": "Mapa dos serviços (quem chama quem)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Gerado a partir dos traces: setas = chamadas/mensagens entre serviços, com taxa e latência",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      }
    },
    {
      "type": "table",
      "title": "Pedido pelo requestId",
      "description": "Preencha o requestId no topo (ele aparece no front e nos scripts)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{span.messaging.message.conversation_id=\"$requestId\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ]
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 6
      }
    },
    {
      "type": "table",
      "title": "Envios de áudio recentes (do front até o fim)",
      "description": "Cada linha é um pedido inteiro; clique no Trace ID para a cascata",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"gateway\"} || {resource.service.name=\"request-service\" && span.http.request.method=\"POST\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ]
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Mais lentos (> 3 s)",
      "description": "Onde o tempo foi gasto (ex.: transcrição, F7)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{duration > 3s}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ]
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "heatmap",
      "title": "Distribuição de latência (todas as operações)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(traces_spanmetrics_latency_bucket{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "scheme": "Oranges",
          "mode": "scheme"
        },
        "cellGap": 1,
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "requestId",
        "label": "requestId (opcional)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "VoxTicket",
      "type": "dashboards",
      "tags": [
        "voxticket"
      ],
      "asDropdown": true
    }
  ]
}
