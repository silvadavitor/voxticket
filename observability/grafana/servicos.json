      "type": "timeseries",
      "title": "Réplicas consumindo cada fila",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Consumidores conectados em cada fila = réplicas do serviço trabalhando. Sobe com --scale (F8) ou com a autoescala na AWS, cai quando uma réplica morre (F2).",
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
