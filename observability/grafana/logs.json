{
  "uid": "voxticket-logs",
  "title": "VoxTicket — Logs",
  "description": "Logs de todos os containers (coletados pelo Alloy), com filtro por serviço, nível e texto.",
  "tags": [
    "voxticket"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Volume de logs por serviço",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name) (count_over_time({source=\"docker\", service_name=~\"$service\", level=~\"$level\"} |~ \"(?i)$busca\" [$__interval]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 7
      }
    },
    {
      "type": "stat",
      "title": "Erros e avisos (período)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({source=\"docker\", service_name=~\"$service\", level=~\"error|warn\"} |~ \"(?i)$busca\" [$__range]))",
          "legendFormat": "{{level}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "id": 2,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      }
    },
    {
      "type": "logs",
      "title": "Logs (mais novos primeiro)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"docker\", service_name=~\"$service\", level=~\"$level\"} |~ \"(?i)$busca\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 18
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "label": "service_name",
          "stream": "{source=\"docker\"}",
          "type": 1,
          "refId": "v"
        },
        "definition": "label_values({source=\"docker\"}, service_name)"
      },
      {
        "name": "level",
        "label": "Nível",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": "error,warn,info,debug",
        "options": [
          {
            "text": "error",
            "value": "error",
            "selected": false
          },
          {
            "text": "warn",
            "value": "warn",
            "selected": false
          },
          {
            "text": "info",
            "value": "info",
            "selected": false
          },
          {
            "text": "debug",
            "value": "debug",
            "selected": false
          }
        ]
      },
      {
        "name": "busca",
        "label": "Contém (texto ou requestId)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "VoxTicket",
      "type": "dashboards",
      "tags": [
        "voxticket"
      ],
      "asDropdown": true
    }
  ]
}
