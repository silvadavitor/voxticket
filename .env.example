# Copie para .env (que NÃO vai para o git).

# ---- ambiente ----
ENVIRONMENT=local
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://ministack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=voxticket-local-audios

# ---- MiniStack ----
# TODO(infra): confirmar nome/tag da imagem na documentação do MiniStack
MINISTACK_IMAGE=ministackorg/ministack:latest

# ---- Postgres (1 container por serviço: postgres-request, postgres-quota, ...; mesma senha local) ----
POSTGRES_PASSWORD=postgres-local-only

# ---- RabbitMQ ----
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- Saga / dependência instável (R5, F1, F7) ----
SAGA_TIMEOUT_MS=60000
TRANSCRIBE_LATENCY_MS_MIN=500
TRANSCRIBE_LATENCY_MS_MAX=3000
TRANSCRIBE_FAILURE_RATE=0.1
TRANSCRIBE_MAX_ATTEMPTS=3
TRANSCRIBER_MODE=fake

# ---- Observabilidade ----
# jaeger (local, sem conta) | datadog (precisa DD_API_KEY)
OTEL_BACKEND=jaeger
DD_API_KEY=
DD_APP_KEY=
# site da conta Datadog, ex.: datadoghq.com, us5.datadoghq.com
DD_SITE=datadoghq.com
