# Copie para .env (que NÃO vai para o git).

# ---- ambiente ----
ENVIRONMENT=local
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://ministack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=voxticket-local-audios

# ---- MiniStack ----
MINISTACK_IMAGE=ministackorg/ministack:1.5.41

# ---- Postgres (1 container por serviço: postgres-request, postgres-quota, ...; mesma senha local) ----
POSTGRES_PASSWORD=postgres-local-only

# ---- RabbitMQ ----
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- Transcrição (Whisper real) ----
# modelo embutido no build da imagem: tiny | base | small | medium
WHISPER_MODEL=base
# idioma do áudio; "auto" = o Whisper detecta
WHISPER_LANGUAGE=pt

# ---- Saga / dependência instável (R5, F1, F7) ----
SAGA_TIMEOUT_MS=60000
# latência extra e taxa de falha INJETADAS por cima do Whisper (0 = só a transcrição real)
TRANSCRIBE_LATENCY_MS_MIN=0
TRANSCRIBE_LATENCY_MS_MAX=0
TRANSCRIBE_FAILURE_RATE=0
TRANSCRIBE_MAX_ATTEMPTS=3

# ---- Observabilidade ----
# local = Grafana LGTM em http://localhost:3000 (sem conta) | datadog (precisa DD_API_KEY)
OTEL_BACKEND=local
DD_API_KEY=
DD_APP_KEY=
# site da conta Datadog, ex.: datadoghq.com, us5.datadoghq.com
DD_SITE=datadoghq.com
